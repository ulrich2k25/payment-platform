generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MerchantStatus {
  ACTIVE
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
  REQUIRES_RECONCILIATION
}

enum PaymentMethod {
  MOBILE_MONEY
  BANK_TRANSFER
  STELLAR
}

enum PaymentProvider {
  SANDBOX
  FAPSHI
  MTN_MOMO
  ORANGE_MONEY
  STELLAR
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REQUIRES_RECONCILIATION
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum WebhookDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  EXHAUSTED
}

enum MerchantProviderAccountStatus {
  ACTIVE
  INACTIVE
}

enum AdminUserStatus {
  ACTIVE
  DISABLED
}

enum MerchantUserStatus {
  ACTIVE
  DISABLED
}

enum MerchantUserRole {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
}

model Merchant {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  webhookUrl    String?
  webhookSecret String?
  status        MerchantStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  apiKeys           ApiKey[]
  payments          Payment[]
  webhookDeliveries WebhookDelivery[]
  providerAccounts  MerchantProviderAccount[]
  users             MerchantUser[]
}

model MerchantProviderAccount {
  id         String                        @id @default(cuid())
  merchantId String
  provider   String
  status     MerchantProviderAccountStatus @default(INACTIVE)

  isDefault Boolean @default(false)
  priority  Int     @default(100)

  credentialsEncrypted String? @db.Text
  externalAccountId    String?
  configuration        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant     Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([merchantId, provider])
  @@index([merchantId, status])
  @@index([provider, status])
}

model ApiKey {
  id         String       @id @default(cuid())
  keyHash    String       @unique
  merchantId String
  status     ApiKeyStatus @default(ACTIVE)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime     @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model Payment {
  id                String          @id @default(cuid())
  merchantId        String
  amount            Int
  currency          String
  method            PaymentMethod
  provider          PaymentProvider @default(SANDBOX)
  reference         String
  providerReference String?
  idempotencyKey    String?
  status            PaymentStatus   @default(PENDING)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  merchant          Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  webhookDeliveries WebhookDelivery[]

  @@unique([merchantId, reference])
  @@unique([merchantId, idempotencyKey])
}

model Transaction {
  id                String            @id @default(cuid())
  paymentId         String
  provider          PaymentProvider
  providerAccountId String?
  providerReference String?
  status            TransactionStatus @default(PENDING)
  amount            Int
  currency          String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  payment         Payment                  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  providerAccount MerchantProviderAccount? @relation(fields: [providerAccountId], references: [id], onDelete: SetNull)

  @@index([providerAccountId])
}

model WebhookDelivery {
  id         String                @id @default(cuid())
  merchantId String
  paymentId  String
  event      String
  webhookUrl String
  payload    Json
  status     WebhookDeliveryStatus @default(PENDING)

  attemptCount Int @default(0)
  replayCount  Int @default(0)

  nextAttemptAt       DateTime @default(now())
  processingStartedAt DateTime?
  lastAttemptAt       DateTime?
  lastReplayedAt      DateTime?
  deliveredAt         DateTime?

  lastError    String?
  responseCode Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  payment  Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([status, processingStartedAt])
  @@index([merchantId, createdAt])
  @@index([paymentId])
}

model AdminUser {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  status       AdminUserStatus @default(ACTIVE)

  lastLoginAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  sessions AdminSession[]
}

model AdminSession {
  id          String   @id @default(cuid())
  adminUserId String
  tokenHash   String   @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model MerchantUser {
  id           String             @id @default(cuid())
  merchantId   String
  email        String             @unique
  passwordHash String
  role         MerchantUserRole   @default(OWNER)
  status       MerchantUserStatus @default(ACTIVE)

  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  sessions MerchantSession[]

  @@index([merchantId, status])
}

model MerchantSession {
  id             String   @id @default(cuid())
  merchantUserId String
  tokenHash      String   @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  merchantUser MerchantUser @relation(fields: [merchantUserId], references: [id], onDelete: Cascade)

  @@index([merchantUserId, expiresAt])
  @@index([expiresAt, revokedAt])
}